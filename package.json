{
  "name": "tischler-federbusch",
  "version": "0.1.0",
  "private": true,
  "description": "Single-page site for Lukas Federbusch - Tischlermeister. Configuration plus static views, gated and statically exported.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.2.2",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "firefox >= 128"
  ],
  "scripts": {
    "predev": "npm run --silent media:link",
    "dev": "next dev",
    "config:validate": "tsx scripts/validate-config.ts",
    "config:validate:strict": "tsx scripts/validate-config.ts --production",
    "media:generate": "tsx scripts/generate-media.ts",
    "postmedia:generate": "npm run --silent media:link",
    "media:link": "portfolio-media-link",
    "export:media": "portfolio-export-media",
    "media:bucket:serve": "portfolio-serve-bucket",
    "fonts:subset": "tsx scripts/subset-fonts.ts",
    "favicons:build": "tsx scripts/build-favicons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:cross": "playwright test --project=cross-chromium --project=cross-webkit --project=cross-mobile",
    "perf:check": "tsx scripts/check-perf-budget.ts",
    "links:check": "tsx scripts/check-links.ts",
    "meta:check": "tsx scripts/check-metadata.ts",
    "media:meta:check": "tsx scripts/check-media-metadata.ts",
    "serve": "tsx scripts/serve.ts",
    "prebuild": "npm run --silent config:validate:strict && npm run --silent media:link",
    "build": "next build",
    "postbuild": "npm run --silent export:media",
    "ci": "tsx scripts/ci.ts",
    "knip": "knip"
  },
  "overrides": {
    "postcss": "8.5.33",
    "sharp": "0.35.5",
    "playwright-core": "1.65.1",
    "esbuild": "0.28.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.9"
    },
    "brace-expansion@^1.1.0": "1.1.22",
    "brace-expansion@^2.0.0": "2.1.4"
  },
  "dependencies": {
    "@mtreml/portfolio-core": "git+https://github.com/mtreml/portfolio-core.git#v1.0.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "knip": "^6.45.1",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.22": true
  }
}
